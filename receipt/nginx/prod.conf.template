# This is the production configuration for the Nginx reverse-proxy.
# It is the only server published to the internet. It serves the built website
# over HTTPS and routes API requests to Django; nothing else of Django is exposed.
#
# ${DOMAIN} is filled in from the environment when the container starts. Every
# other $name is an Nginx variable. The certificate is expected at
# /etc/letsencrypt/live/${DOMAIN}/, mounted from the host.

server_tokens off;

# Requests per visitor. cloudflare-realip.conf makes $binary_remote_addr the
# visitor's own address rather than Cloudflare's. A visitor over the limit gets
# a 429, as from Django's throttles.
limit_req_zone $binary_remote_addr zone=auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=api:10m rate=20r/s;
limit_req_status 429;

ssl_protocols TLSv1.2 TLSv1.3;
ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
ssl_prefer_server_ciphers off;
ssl_session_cache shared:SSL:10m;
ssl_session_timeout 1d;
ssl_session_tickets off;

gzip on;
gzip_vary on;
gzip_proxied any;
gzip_min_length 1024;
gzip_types text/css application/javascript application/json image/svg+xml;

# Any hostname other than ours, including the bare IP address: close the
# connection without a reply
server {
    listen 80 default_server;
    listen 443 ssl default_server;
    ssl_reject_handshake on;
    return 444;
}

server {
    listen 80;
    server_name ${DOMAIN} www.${DOMAIN};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN} www.${DOMAIN};
    root /usr/share/nginx/html;
    index index.html;

    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    # Set here once for every response. A location must not use add_header
    # itself, as it would then lose all of these.
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "same-origin" always;
    # The website loads everything from this server. blob: is for the uploaded
    # documents, which are fetched with the user's token and opened from memory.
    add_header Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; frame-src blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

    # Django sends some of the same headers; keep only the ones above
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header Referrer-Policy;

    # Just above the 50 MB that Django accepts for one document, to leave room
    # for the rest of the upload form
    client_max_body_size 51m;

    # Django is looked up through Docker's DNS on each use, not once at
    # startup, so Nginx keeps finding it after the web container is recreated
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $django http://web:8000;

    proxy_set_header Host $host;
    # Replaced rather than added to, so Django sees one address it can trust
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    # Gunicorn gives a request 95 s and Cloudflare gives up at 100 s
    proxy_read_timeout 100s;
    proxy_send_timeout 100s;

    #Django: logging in and registering
    location ~ ^/api/(token|register|auth/(login|registration|password))/ {
        limit_req zone=auth burst=10 nodelay;
        proxy_pass $django;
    }

    #Django: the rest of the API
    location /api/ {
        limit_req zone=api burst=40 nodelay;
        proxy_pass $django;
    }

    # Django's admin site and files are not served, and without this the
    # website would answer for them
    location ~ ^/(admin|media|static)(/|$) {
        return 404;
    }

    #Vite: file names carry a hash of their content, so they never change
    location /assets/ {
        expires 1y;
        try_files $uri =404;
    }

    # The page that names those files must always be checked for a new version
    location = /index.html {
        expires -1;
    }

    location / {
        try_files $uri /index.html;
    }
}
